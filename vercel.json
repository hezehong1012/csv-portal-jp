      "destination": "/en/csv-dedup.html"
    },
    {
      "source": "/en/csv-split",
      "destination": "/en/csv-split.html"
    },
    {
      "source": "/en/csv-merge",
      "destination": "/en/csv-merge.html"
    },
    {
      "source": "/en/csv-diff",
      "destination": "/en/csv-diff.html"
