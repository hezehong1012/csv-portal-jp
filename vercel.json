{
  "functions": {
    "api/repair.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/en/en",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/en/en/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/en/en/:path*",
      "destination": "/en/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/csv-dedup",
      "destination": "/csv-dedup.html"
    },
    {
      "source": "/csv-split",
      "destination": "/csv-split.html"
